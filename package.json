{
  "name": "shg-cli",
  "version": "2026.4.3",
  "description": "A modern interactive CLI for Capacitor Android development",
  "main": "dist/index.js",
  "bin": {
    "shg": "dist/index.js"
  },
  "scripts": {
    "build": "bun run tsc",
    "typecheck": "bun run tsc --noEmit",
    "smoke": "bun run typecheck && bun run build",
    "test": "bun test",
    "dev": "bun src/index.ts",
    "start": "bun dist/index.js",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "keywords": [
    "capacitor",
    "android",
    "cli",
    "ionic",
    "mobile",
    "shg"
  ],
  "author": "SHG (Sub-company of Xalo Software) - T-kay Tinotenda Mutumbiwenzou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diplovee/shg.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "chalk": "^5.6.2",
    "execa": "^9.6.1",
    "figlet": "^1.11.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  }
}
